{
  "buildCommand": "pnpm run typecheck:libs && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/ari-water run build",
  "outputDirectory": "artifacts/ari-water/dist/public",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/payments/[...path].js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/payments/webhook/lipana.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
