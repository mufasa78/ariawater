# Production Environment Variables Template
# Copy this to .env.production and fill in your values

# === Required for API Server ===
NODE_ENV=production
PORT=10000
JWT_SECRET=your_jwt_secret_here_min_32_chars
CONVEX_URL=https://your-deployment.convex.cloud/
CONVEX_DEPLOYMENT_URL=https://your-deployment.convex.cloud/

# === Frontend/CORS Configuration ===
ALLOWED_ORIGINS=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# === Required for Frontend ===
VITE_API_URL=https://your-api-domain.com

# === Payment Provider (Optional) ===
PAYMENT_PROVIDER=lipana

# Lipana M-Pesa (if using)
LIPANA_PUBLISHABLE_KEY=lip_pk_live_...
LIPANA_SECRET_KEY=lip_sk_live_...
LIPANA_WEBHOOK_SECRET=...
LIPANA_WEBHOOK_URL=https://your-api-domain.com/api/webhooks/lipana

# Paystack (alternative to Lipana)
# PAYSTACK_SECRET_KEY=sk_test_...

# === Email Service (Optional but Recommended) ===
# Choose one:

# SendGrid
# SENDGRID_API_KEY=SG...
# FROM_EMAIL=noreply@ariwater.co.ke

# AWS SES
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# FROM_EMAIL=noreply@ariwater.co.ke

# Resend
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@ariwater.co.ke
